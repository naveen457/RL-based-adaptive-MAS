

# ==============================================================================
# 2. NVIDIA NIM (Alternative Free Tier, Model-scoped keys)
# Get keys at https://build.nvidia.com
# ==============================================================================
NVIDIA_API_KEY="your_nvidia_api_key_here"
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"
NVIDIA_MODEL="nvidia/nemotron-3.5-lightning-30b-a3b"

# ==============================================================================
# 4. LangSmith Observability (Set to false for fastest local CLI latency)
# ==============================================================================
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
LANGCHAIN_API_KEY="your_langsmith_api_key_here"
LANGCHAIN_PROJECT="adaptive-mas"

# ==============================================================================
# 5. External Tool APIs
# ==============================================================================
TAVILY_API_KEY="tvly-your_tavily_api_key_here"

# ==============================================================================
# 6. MongoDB Atlas Persistence (Threads, Q-Table, Evaluation Runs)
# ==============================================================================
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB_NAME="adaptive_mas"

